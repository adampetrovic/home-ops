---
global:
  resolve_timeout: 5m
route:
  group_by: ["alertname", "job"]
  group_interval: 10m
  group_wait: 1m
  receiver: telegram
  repeat_interval: 12h
  routes:
    - receiver: heartbeat
      matchers:
        - alertname = "Watchdog"
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m
      continue: false
    - receiver: "null"
      matchers:
        - alertname = "InfoInhibitor"
      continue: false
    - receiver: telegram
      continue: true
      matchers:
        - severity = "critical"
    # Telegram is unreachable during a WAN outage; Home Assistant can still push locally.
    - receiver: homeassistant
      matchers:
        - alertname = "WANDown"
      continue: true
    # Home Assistant power-cycles the coordinator's PoE port.
    - receiver: homeassistant-zigbee-recovery
      matchers:
        - alertname =~ "ZigbeeCoordinatorRadioStuck|ZigbeeCoordinatorUnreachable"
      repeat_interval: 2h
      continue: true
inhibit_rules:
  - equal: ["alertname", "namespace"]
    source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
  - equal: ["namespace"]
    source_matchers:
      - alertname = "InfoInhibitor"
    target_matchers:
      - severity = "info"
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "KustomizationReconciliationFailure|KustomizationsBlockedOnDependency|FluxSourceReconciliationFailure|FluxInstanceNotReady"
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "AlertmanagerFailedToSendAlerts|AlertmanagerClusterFailedToSendAlerts"
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "KubePodCrashLooping|KubeDeploymentReplicasMismatch|KubePodNotReady|TargetDown|GatusExternalEndpointDown"
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "TeslaMateApiErrorStorm|TeslaMateErrorLogs"
receivers:
  - name: "null"
  - name: heartbeat
    webhook_configs:
      - url: "{{ .HEALTHCHECKS_url }}"
        send_resolved: false
  - name: homeassistant
    webhook_configs:
      - url: "http://home-assistant.automation.svc.cluster.local:8123/api/webhook/wan-status"
        send_resolved: true
  - name: homeassistant-zigbee-recovery
    webhook_configs:
      - url: "http://home-assistant.automation.svc.cluster.local:8123/api/webhook/zigbee-coordinator-recovery"
        send_resolved: false
  - name: telegram
    telegram_configs:
      - send_resolved: true
        chat_id: {{ .TELEGRAM_CHAT_ID }}
        bot_token: {{ .TELEGRAM_BOT_TOKEN }}
        parse_mode: "HTML"
        # Explicit newlines survive both ExternalSecret and Alertmanager rendering.
        message: |-
          {{ "{{-" }} define "__telegram_resource" {{ "-}}" }}
            {{ "{{-" }} if .Labels.namespace {{ "-}}" }}
              {{ "{{-" }} printf "%s / " (.Labels.namespace | printf "%.100s" | html) {{ "-}}" }}
            {{ "{{-" }} end {{ "-}}" }}
            {{ "{{-" }} if .Labels.pod {{ "-}}" }}
              {{ "{{-" }} .Labels.pod | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.deployment {{ "-}}" }}
              {{ "{{-" }} .Labels.deployment | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.node {{ "-}}" }}
              {{ "{{-" }} .Labels.node | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.instance {{ "-}}" }}
              {{ "{{-" }} .Labels.instance | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.job {{ "-}}" }}
              {{ "{{-" }} .Labels.job | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else {{ "-}}" }}
              {{ "{{-" }} .Labels.alertname | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} end {{ "-}}" }}
            {{ "{{-" }} if .Labels.container {{ "}}" }} — {{ "{{" }} .Labels.container | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} end {{ "-}}" }}
          {{ "{{-" }} end {{ "-}}" }}
          {{ "{{-" }} if eq .Status "resolved" {{ "-}}" }}
            ✅
          {{ "{{-" }} else if eq .CommonLabels.severity "info" {{ "-}}" }}
            ℹ️
          {{ "{{-" }} else if eq .CommonLabels.severity "warning" {{ "-}}" }}
            ⚠️
          {{ "{{-" }} else {{ "-}}" }}
            🔴
          {{ "{{-" }} end {{ "}}" }} <b>{{ "{{" }} .Status | toUpper | html {{ "}}" }} · {{ "{{" }} .CommonLabels.alertname | html {{ "}}" }}</b>
          {{ "{{-" }} $firing := len .Alerts.Firing {{ "-}}" }}
          {{ "{{-" }} $resolved := len .Alerts.Resolved {{ "-}}" }}
          {{ "{{-" }} printf "\n" {{ "-}}" }}
          {{ "{{-" }} if $firing {{ "}}{{" }} $firing {{ "}}" }} firing{{ "{{" }} end {{ "-}}" }}
          {{ "{{-" }} if and $firing $resolved {{ "}}" }} · {{ "{{" }} end {{ "-}}" }}
          {{ "{{-" }} if $resolved {{ "}}{{" }} $resolved {{ "}}" }} recovered{{ "{{" }} end {{ "-}}" }}
          {{ "{{-" }} range $index, $alert := .Alerts {{ "-}}" }}
            {{ "{{-" }} if lt $index 5 {{ "-}}" }}
              {{ "{{-" }} printf "\n\n• " {{ "-}}" }}
              {{ "{{-" }} if and $firing (eq .Status "resolved") {{ "}}" }}✅ {{ "{{" }} end {{ "-}}" }}
              <b>{{ "{{" }} template "__telegram_resource" . {{ "}}" }}</b>
              {{ "{{-" }} if eq .Status "firing" {{ "-}}" }}
                {{ "{{-" }} if .Annotations.summary {{ "-}}" }}
                  {{ "{{-" }} printf "\n  " {{ "}}{{" }} .Annotations.summary | printf "%.160s" | html {{ "-}}" }}
                {{ "{{-" }} end {{ "-}}" }}
                {{ "{{-" }} if and .Annotations.description (ne .Annotations.description .Annotations.summary) {{ "-}}" }}
                  {{ "{{-" }} printf "\n  " {{ "}}{{" }} .Annotations.description | printf "%.300s" | html {{ "-}}" }}
                {{ "{{-" }} end {{ "-}}" }}
                {{ "{{-" }} if or .GeneratorURL .Annotations.runbook_url {{ "-}}" }}
                  {{ "{{-" }} printf "\n  " {{ "-}}" }}
                  {{ "{{-" }} if .GeneratorURL {{ "-}}" }}
                    <a href="{{ "{{" }} .GeneratorURL | html {{ "}}" }}">↗ Prometheus</a>
                  {{ "{{-" }} end {{ "-}}" }}
                  {{ "{{-" }} if and .GeneratorURL .Annotations.runbook_url {{ "}}" }} · {{ "{{" }} end {{ "-}}" }}
                  {{ "{{-" }} if .Annotations.runbook_url {{ "-}}" }}
                    <a href="{{ "{{" }} .Annotations.runbook_url | html {{ "}}" }}">Runbook</a>
                  {{ "{{-" }} end {{ "-}}" }}
                {{ "{{-" }} end {{ "-}}" }}
              {{ "{{-" }} end {{ "-}}" }}
            {{ "{{-" }} else if eq $index 5 {{ "-}}" }}
              {{ "{{-" }} printf "\n\n+ " {{ "-}}" }}
              {{ "{{-" }} len (slice $.Alerts 5) {{ "}}" }} more
            {{ "{{-" }} end {{ "-}}" }}
          {{ "{{-" }} end {{ "-}}" }}
