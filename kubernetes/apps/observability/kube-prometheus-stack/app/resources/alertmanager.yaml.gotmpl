---
global:
  resolve_timeout: 5m
route:
  group_by: ["alertname", "job"]
  group_interval: 10m
  group_wait: 1m
  receiver: telegram
  repeat_interval: 12h
  routes:
    - receiver: "null"
      matchers:
        - alertname =~ "InfoInhibitor|Watchdog"
      continue: false
    - receiver: telegram
      continue: true
      matchers:
        - severity = "critical"
    # WANDown → Home Assistant webhook for local push notifications.
    # Telegram won't work during an outage (no internet), but HA can
    # deliver notifications via local push over the WebSocket API
    # without needing Apple/Google push services.
    - receiver: homeassistant
      matchers:
        - alertname = "WANDown"
      continue: true
    # Zigbee2MQTT coordinator alerts → Home Assistant webhook to
    # power-cycle the Zigbee coordinator's UniFi PoE port. Keep repeat
    # interval long; HA also enforces its own cooldown.
    - receiver: homeassistant-zigbee-recovery
      matchers:
        - alertname =~ "ZigbeeCoordinatorRadioStuck|ZigbeeCoordinatorUnreachable"
      repeat_interval: 2h
      continue: true
inhibit_rules:
  - equal: ["alertname", "namespace"]
    source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
  # During WAN outage (and for 10 min after recovery), suppress downstream
  # alerts. Uses WANDownBuffer which persists beyond WANDown to cover the
  # recovery window while pods restart, Flux re-reconciles, and targets
  # come back online. WANDown is also kept as a source so that inhibition
  # starts immediately (WANDownBuffer has for: 0s, but belt-and-suspenders).
  #
  # Flux: can't pull OCI artifacts without internet
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "KustomizationReconciliationFailure|FluxInstanceNotReady"
  # Alertmanager: can't reach Telegram API without internet
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "AlertmanagerFailedToSendAlerts|AlertmanagerClusterFailedToSendAlerts"
  # Pods/deployments/targets: services in ANY namespace may crash-loop or
  # become unavailable when internet is down (image pulls, cloud APIs, DNS).
  # Previously restricted to namespace=network which let media alerts through.
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "KubePodCrashLooping|KubeDeploymentReplicasMismatch|KubePodNotReady|TargetDown|GatusExternalEndpointDown"
  # TeslaMate's log-rate alerts flood during a WAN outage (every Tesla API call
  # fails with connection/DNS errors). Suppress them while WAN is down and through
  # the recovery buffer. Their count_over_time windows are 10m to match
  # WANDownBuffer's 10m post-recovery coverage, so outage noise ages out of the
  # window before the buffer clears (no spurious post-recovery fire).
  - source_matchers:
      - alertname =~ "WANDown|WANDownBuffer"
    target_matchers:
      - alertname =~ "TeslaMateApiErrorStorm|TeslaMateErrorLogs"
receivers:
  - name: "null"
  - name: homeassistant
    webhook_configs:
      - url: "http://home-assistant.automation.svc.cluster.local:8123/api/webhook/wan-status"
        send_resolved: true
  - name: homeassistant-zigbee-recovery
    webhook_configs:
      - url: "http://home-assistant.automation.svc.cluster.local:8123/api/webhook/zigbee-coordinator-recovery"
        send_resolved: false
  - name: telegram
    telegram_configs:
      - send_resolved: true
        chat_id: {{ .TELEGRAM_CHAT_ID }}
        bot_token: {{ .TELEGRAM_BOT_TOKEN }}
        parse_mode: "HTML"
        # Explicit newlines survive both ExternalSecret and Alertmanager rendering.
        # Bound annotation text and show at most five resources per notification.
        message: |-
          {{ "{{-" }} define "__telegram_resource" {{ "-}}" }}
            {{ "{{-" }} if .Labels.namespace {{ "-}}" }}
              {{ "{{-" }} printf "%s / " (.Labels.namespace | printf "%.100s" | html) {{ "-}}" }}
            {{ "{{-" }} end {{ "-}}" }}
            {{ "{{-" }} if .Labels.pod {{ "-}}" }}
              {{ "{{-" }} .Labels.pod | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.deployment {{ "-}}" }}
              {{ "{{-" }} .Labels.deployment | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.node {{ "-}}" }}
              {{ "{{-" }} .Labels.node | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.instance {{ "-}}" }}
              {{ "{{-" }} .Labels.instance | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else if .Labels.job {{ "-}}" }}
              {{ "{{-" }} .Labels.job | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} else {{ "-}}" }}
              {{ "{{-" }} .Labels.alertname | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} end {{ "-}}" }}
            {{ "{{-" }} if .Labels.container {{ "}}" }} — {{ "{{" }} .Labels.container | printf "%.100s" | html {{ "-}}" }}
            {{ "{{-" }} end {{ "-}}" }}
          {{ "{{-" }} end {{ "-}}" }}
          {{ "{{-" }} if eq .Status "resolved" {{ "-}}" }}
            ✅
          {{ "{{-" }} else if eq .CommonLabels.severity "info" {{ "-}}" }}
            ℹ️
          {{ "{{-" }} else if eq .CommonLabels.severity "warning" {{ "-}}" }}
            ⚠️
          {{ "{{-" }} else {{ "-}}" }}
            🔴
          {{ "{{-" }} end {{ "}}" }} <b>{{ "{{" }} .Status | toUpper | html {{ "}}" }} · {{ "{{" }} .CommonLabels.alertname | html {{ "}}" }}</b>
          {{ "{{-" }} $firing := len .Alerts.Firing {{ "-}}" }}
          {{ "{{-" }} $resolved := len .Alerts.Resolved {{ "-}}" }}
          {{ "{{-" }} printf "\n" {{ "-}}" }}
          {{ "{{-" }} if $firing {{ "}}{{" }} $firing {{ "}}" }} firing{{ "{{" }} end {{ "-}}" }}
          {{ "{{-" }} if and $firing $resolved {{ "}}" }} · {{ "{{" }} end {{ "-}}" }}
          {{ "{{-" }} if $resolved {{ "}}{{" }} $resolved {{ "}}" }} recovered{{ "{{" }} end {{ "-}}" }}
          {{ "{{-" }} range $index, $alert := .Alerts {{ "-}}" }}
            {{ "{{-" }} if lt $index 5 {{ "-}}" }}
              {{ "{{-" }} printf "\n\n• " {{ "-}}" }}
              {{ "{{-" }} if and $firing (eq .Status "resolved") {{ "}}" }}✅ {{ "{{" }} end {{ "-}}" }}
              <b>{{ "{{" }} template "__telegram_resource" . {{ "}}" }}</b>
              {{ "{{-" }} if eq .Status "firing" {{ "-}}" }}
                {{ "{{-" }} if .Annotations.summary {{ "-}}" }}
                  {{ "{{-" }} printf "\n  " {{ "}}{{" }} .Annotations.summary | printf "%.160s" | html {{ "-}}" }}
                {{ "{{-" }} end {{ "-}}" }}
                {{ "{{-" }} if and .Annotations.description (ne .Annotations.description .Annotations.summary) {{ "-}}" }}
                  {{ "{{-" }} printf "\n  " {{ "}}{{" }} .Annotations.description | printf "%.300s" | html {{ "-}}" }}
                {{ "{{-" }} end {{ "-}}" }}
                {{ "{{-" }} if or .GeneratorURL .Annotations.runbook_url {{ "-}}" }}
                  {{ "{{-" }} printf "\n  " {{ "-}}" }}
                  {{ "{{-" }} if .GeneratorURL {{ "-}}" }}
                    <a href="{{ "{{" }} .GeneratorURL | html {{ "}}" }}">↗ Prometheus</a>
                  {{ "{{-" }} end {{ "-}}" }}
                  {{ "{{-" }} if and .GeneratorURL .Annotations.runbook_url {{ "}}" }} · {{ "{{" }} end {{ "-}}" }}
                  {{ "{{-" }} if .Annotations.runbook_url {{ "-}}" }}
                    <a href="{{ "{{" }} .Annotations.runbook_url | html {{ "}}" }}">Runbook</a>
                  {{ "{{-" }} end {{ "-}}" }}
                {{ "{{-" }} end {{ "-}}" }}
              {{ "{{-" }} end {{ "-}}" }}
            {{ "{{-" }} else if eq $index 5 {{ "-}}" }}
              {{ "{{-" }} printf "\n\n+ " {{ "-}}" }}
              {{ "{{-" }} len (slice $.Alerts 5) {{ "}}" }} more
            {{ "{{-" }} end {{ "-}}" }}
          {{ "{{-" }} end {{ "-}}" }}
