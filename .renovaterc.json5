{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>adampetrovic/home-ops//.renovate/autoMerge.json5",
    "github>adampetrovic/home-ops//.renovate/customManagers.json5",
    "github>adampetrovic/home-ops//.renovate/grafanaDashboards.json5",
    "github>adampetrovic/home-ops//.renovate/groups.json5",
    "github>adampetrovic/home-ops//.renovate/labels.json5",
    "github>adampetrovic/home-ops//.renovate/semanticCommits.json5",
    "github>adampetrovic/home-ops//.renovate/sourceUrls.json5",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Australia/Sydney)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  packageRules: [
    {
      description: "Keep Logseq sync upgrades manual until client compatibility and restores are verified",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/yshalsager/logseq-selfhost-sync"],
      enabled: false,
    },
    {
      description: "Disable mise 1Password CLI updates because Renovate resolves it to a non-public GitHub repo",
      matchManagers: ["mise"],
      matchPackageNames: ["1password/cli"],
      enabled: false,
    },
    {
      description: "Ignore digest updates for images that already have version tags",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchCurrentValue: "/^.+$/",
      enabled: false,
    },
    {
      description: "Postgres major versions need pg_upgrade or a dump/restore; keep CNPG cluster images within their major",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/postgis",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/tensorchord/cloudnative-vectorchord",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Parse CNPG PostGIS and VectorChord tags, whose suffix carries the extension version",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/postgis",
        "ghcr.io/tensorchord/cloudnative-vectorchord",
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)(?:-(?<compatibility>standard-bookworm))?$",
    },
    {
      description: "Parse CNPG PostgreSQL build-stamped tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{12})-(?<compatibility>minimal-trixie)$",
    },
  ],
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  registryAliases: {
    "mirror.gcr.io": "docker.io",
  },
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
}
