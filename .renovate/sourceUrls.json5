{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Use upstream release notes for code-server",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/coder/code-server"],
      sourceUrl: "https://github.com/coder/code-server",
    },
    {
      description: "Use upstream release notes for Baby Buddy",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/linuxserver/babybuddy"],
      sourceUrl: "https://github.com/babybuddy/babybuddy",
    },
    {
      description: "Use chart release notes for snapshot-controller chart",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/piraeusdatastore/helm-charts/snapshot-controller"],
      sourceUrl: "https://github.com/piraeusdatastore/helm-charts",
    },
    {
      description: "Use upstream release notes for Readeck",
      matchDatasources: ["docker"],
      matchPackageNames: ["codeberg.org/readeck/readeck"],
      sourceUrl: "https://codeberg.org/readeck/readeck",
      changelogUrl: "https://codeberg.org/readeck/readeck/releases",
    },
    {
      description: "Use upstream release notes for Frigate",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/blakeblackshear/frigate"],
      sourceUrl: "https://github.com/blakeblackshear/frigate",
    },
    {
      description: "Use upstream release notes for Ceph CSI chart mirror",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/ceph-csi-drivers"],
      sourceUrl: "https://github.com/ceph/csi-charts",
    },
    {
      description: "Use upstream release notes for Plex",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/plex"],
      sourceUrl: "https://github.com/home-operations/containers",
      changelogUrl: "https://forums.plex.tv/t/plex-media-server/30447/713",
    },
    {
      description: "Use upstream release notes for Atuin",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/atuinsh/atuin"],
      sourceUrl: "https://github.com/atuinsh/atuin",
    },
    {
      description: "Use chart release notes for CoreDNS chart",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/coredns/charts/coredns"],
      sourceUrl: "https://github.com/coredns/helm",
    },
    {
      description: "Use upstream release notes for Grafana Operator chart",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/grafana/helm-charts/grafana-operator"],
      sourceUrl: "https://github.com/grafana/grafana-operator",
    },
    {
      description: "Use upstream release notes for Ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/ceph/ceph"],
      sourceUrl: "https://github.com/ceph/ceph",
      changelogUrl: "https://docs.ceph.com/en/latest/releases/",
    },
    {
      description: "Use container release notes for postgres-init",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/postgres-init"],
      sourceUrl: "https://github.com/home-operations/containers",
    },
  ],
}
