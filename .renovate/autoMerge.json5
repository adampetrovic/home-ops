{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  automerge: false,
  automergeType: "pr",
  automergeStrategy: "rebase",
  platformAutomerge: false,
  ignoreTests: false,
  rebaseWhen: "conflicted",
  packageRules: [
    // Docker Hub images are listed as docker.io/... because registryAliases maps mirror.gcr.io to docker.io
    {
      description: "Auto-merge patch and minor updates for stateless, sidecar and leaf workloads",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/coder/code-server",
        "ghcr.io/autobrr/qui",
        "ghcr.io/unpoller/unpoller",
        "ghcr.io/browserless/chromium",
        "ghcr.io/dgtlmoon/changedetection.io",
        "ghcr.io/asciimoo/hister",
        "ghcr.io/home-operations/gatus-sidecar",
        "ghcr.io/twin/gatus",
        "ghcr.io/home-operations/k8s-sidecar",
        "ghcr.io/bakito/adguardhome-sync",
        "ghcr.io/stakater/charts/reloader",
        "ghcr.io/home-operations/tautulli",
        "ghcr.io/dictionarry-hub/profilarr",
        "ghcr.io/dictionarry-hub/profilarr-parser",
        "docker.io/golift/unpackerr",
        "docker.io/apache/tika",
        "docker.io/thecodingmachine/gotenberg",
        "docker.io/dpage/pgadmin4",
        "docker.io/khairul169/garage-webui",
        "ghcr.io/kubetail-org/helm-charts/kubetail",
        "quay.io/prometheuscommunity/smartctl-exporter",
        "ghcr.io/mendhak/http-https-echo",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Keep minor updates separate from auto-merged patches",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/lidarr",
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/bazarr",
        "ghcr.io/home-operations/sabnzbd",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/calibrain/shelfmark",
        "ghcr.io/home-operations/qbittorrent",
        "ghcr.io/connorgallopo/tracearr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/zariel/cleanrr",
        "docker.io/kometateam/imagemaid",
        "ghcr.io/bookorbit/bookorbit",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/home-operations/esphome",
        "docker.io/seud0nym/sigenergy2mqtt",
        "docker.io/teslamate/teslamate",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "ghcr.io/atuinsh/atuin",
        "docker.io/actualbudget/actual-server",
        "ghcr.io/usememos/memos",
        "codeberg.org/readeck/readeck",
        "ghcr.io/miniflux/miniflux",
        "ghcr.io/sysadminsmedia/homebox",
        "ghcr.io/linuxserver/babybuddy",
        "ghcr.io/crazy-max/samba",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "quay.io/prometheus/prometheus",
        "ghcr.io/grafana/helm-charts/grafana-operator",
        "docker.io/cloudflare/cloudflared",
        "docker.io/1password/connect-api",
        "docker.io/1password/connect-sync",
        "ghcr.io/dragonflydb/dragonfly",
        "docker.io/timberio/vector",
        "ghcr.io/foxcpp/maddy",
        "docker.io/cturra/ntp",
        "ghcr.io/mafredri/unifi-os-backup",
        "gsoci.azurecr.io/charts/giantswarm/silence-operator",
        "ghcr.io/home-operations/charts-mirror/metrics-server",
        "ghcr.io/home-operations/charts-mirror/descheduler",
        "registry.k8s.io/nfd/charts/node-feature-discovery",
        "ghcr.io/intel/helm-charts/intel-device-plugins-operator",
        "ghcr.io/intel/helm-charts/intel-device-plugins-gpu",
        "registry.k8s.io/git-sync/git-sync",
      ],
      separateMinorPatch: true,
    },
    {
      description: "Auto-merge patch updates for stateful and user-facing workloads; minors stay manual",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/lidarr",
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/bazarr",
        "ghcr.io/home-operations/sabnzbd",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/calibrain/shelfmark",
        "ghcr.io/home-operations/qbittorrent",
        "ghcr.io/connorgallopo/tracearr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/zariel/cleanrr",
        "docker.io/kometateam/imagemaid",
        "ghcr.io/bookorbit/bookorbit",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/home-operations/esphome",
        "docker.io/seud0nym/sigenergy2mqtt",
        "docker.io/teslamate/teslamate",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "ghcr.io/atuinsh/atuin",
        "docker.io/actualbudget/actual-server",
        "ghcr.io/usememos/memos",
        "codeberg.org/readeck/readeck",
        "ghcr.io/miniflux/miniflux",
        "ghcr.io/sysadminsmedia/homebox",
        "ghcr.io/linuxserver/babybuddy",
        "ghcr.io/crazy-max/samba",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "quay.io/prometheus/prometheus",
        "ghcr.io/grafana/helm-charts/grafana-operator",
        "docker.io/cloudflare/cloudflared",
        "docker.io/1password/connect-api",
        "docker.io/1password/connect-sync",
        "ghcr.io/dragonflydb/dragonfly",
        "docker.io/timberio/vector",
        "ghcr.io/foxcpp/maddy",
        "docker.io/cturra/ntp",
        "ghcr.io/mafredri/unifi-os-backup",
        "gsoci.azurecr.io/charts/giantswarm/silence-operator",
        "ghcr.io/home-operations/charts-mirror/metrics-server",
        "ghcr.io/home-operations/charts-mirror/descheduler",
        "registry.k8s.io/nfd/charts/node-feature-discovery",
        "ghcr.io/intel/helm-charts/intel-device-plugins-operator",
        "ghcr.io/intel/helm-charts/intel-device-plugins-gpu",
        "registry.k8s.io/git-sync/git-sync",
      ],
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      description: "Auto-merge mise tool updates",
      matchManagers: ["mise"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Keep minor updates for cluster-tracked CLIs manual so they stay aligned with the cluster",
      matchManagers: ["mise"],
      matchDepNames: ["flux2", "kubectl", "talosctl"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
  ],
}
