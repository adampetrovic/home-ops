{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  automerge: false,
  automergeType: "pr",
  automergeStrategy: "rebase",
  platformAutomerge: false,
  ignoreTests: false,
  rebaseWhen: "conflicted",
  packageRules: [
    {
      description: "Auto-merge patch, minor and digest updates; the main ruleset holds each merge until Kritika approves it",
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      description: "Offer patches separately so they can merge while a riskier minor waits for review",
      matchDatasources: ["docker"],
      separateMinorPatch: true,
    },
    {
      description: "Keep minor updates for cluster-tracked CLIs manual so they stay aligned with the cluster",
      matchManagers: ["mise"],
      matchDepNames: ["flux2", "kubectl", "talosctl"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      description: "Keep Kritika updates manual: it approves the other updates and its configuration changes between releases",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/charts/kritika"],
      automerge: false,
    },
  ],
}
