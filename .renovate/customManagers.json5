{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process CloudNative-PG imageName and extension image references",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "(?:imageName|reference): +(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process git-sync commit pins",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "GITSYNC_REPO: (?<depName>https://\\S+)\\n\\s+GITSYNC_REF: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>\\S+)",
      ],
      datasourceTemplate: "git-refs",
    },
    {
      customType: "regex",
      description: "Process grafana-operator Grafana image references",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "version: (?<depName>mirror\\.gcr\\.io/grafana/grafana):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process TeslaMate Grafana dashboard URLs",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "url: https://raw\\.githubusercontent\\.com/(?<depName>teslamate-org/teslamate)/(?<currentValue>v[^/\\s]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: [
        "/(^|/).+\\.env$/",
        "/(^|/).+\\.sh$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // version: v1.37.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // A version embedded in a URL path segment on the following line.
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Kubernetes image tags in native Talos templates",
      managerFilePatterns: ["/(^|/)talos/[^/]+\\.ya?ml\\.j2$/"],
      matchStrings: [
        "image: +(?<depName>ghcr\\.io/siderolabs/kubelet|registry\\.k8s\\.io/kube-(?:apiserver|controller-manager|scheduler|proxy)):(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process Talos Image Factory installer tags in native node templates",
      managerFilePatterns: ["/(^|/)talos/nodes/.+\\.ya?ml\\.j2$/"],
      matchStrings: [
        "factory\\.talos\\.dev/metal-installer/\\{\\{\\s*schematic\\s*\\}\\}:(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/siderolabs/talos",
    },
  ],
}
