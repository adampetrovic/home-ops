{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Ignore private GHCR images maintained by repo owner",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/adampetrovic/**"],
      enabled: false,
    },
    {
      description: "Keep native Talos Kubernetes images aligned for controlled upgrades",
      groupName: "Kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kube-proxy",
      ],
      automerge: false,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "mise-managed tool versions",
      groupName: "mise tools",
      matchManagers: ["mise"],
      matchFileNames: [".mise.toml"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Barman Cloud Group",
      groupName: "Barman Cloud",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/plugin-barman-cloud-sidecar/", "/plugin-barman-cloud/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Keep the Dragonfly operator image and its CRD manifest on the same release",
      groupName: "Dragonfly Operator",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["ghcr.io/dragonflydb/operator", "dragonflydb/dragonfly-operator"],
      separateMinorPatch: false,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Keep TeslaMate dashboards on the same release as the deployed image",
      groupName: "TeslaMate",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/(^|/)teslamate(-org)?/teslamate$/"],
      // the GitHub release usually lands before the Docker image; wait so both ship in one branch
      minimumReleaseAge: "1 day",
      separateMinorPatch: true,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Auto-merge TeslaMate dashboard patches alongside the image's patch auto-merge",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["teslamate-org/teslamate"],
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      description: "Cert-Manager Group",
      groupName: "Cert-Manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cert-manager/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Cilium Group",
      groupName: "Cilium",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cilium/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "CoreDNS Group",
      groupName: "CoreDNS",
      matchDatasources: ["docker"],
      matchPackageNames: ["/coredns/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Envoy Gateway Group: chart, controller image, and the Envoy proxy version it ships",
      groupName: "Envoy Gateway",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "docker.io/envoyproxy/gateway-helm",
        "docker.io/envoyproxy/gateway",
        "docker.io/envoyproxy/envoy",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "External Secrets Operator Group",
      groupName: "External Secrets Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/external-secrets/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Intel Device Plugins Group",
      groupName: "Intel-Device-Plugins",
      matchDatasources: ["docker"],
      matchPackageNames: ["/intel-device-plugins-operator/", "/intel-device-plugins-gpu/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "1Password Connect Group",
      groupName: "1Password Connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/1password/connect-api", "docker.io/1password/connect-sync"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Profilarr Group",
      groupName: "Profilarr",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/dictionarry-hub/profilarr", "ghcr.io/dictionarry-hub/profilarr-parser"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Rook-Ceph Group",
      groupName: "Rook-Ceph",
      matchDatasources: ["docker"],
      // docker.io/rook/ceph is the operator image, pinned to the chart version
      matchPackageNames: ["ghcr.io/rook/rook-ceph", "ghcr.io/rook/rook-ceph-cluster", "docker.io/rook/ceph"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Spegel Group",
      groupName: "Spegel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/spegel/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
  ],
}
