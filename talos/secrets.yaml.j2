---
# 1Password-backed Talos secrets bundle for generating talosconfig only.
# Render through `talos/scripts/template.sh`; never commit rendered output.
cluster:
  id: op://k8s/talsecret/CLUSTER_ID
  secret: op://k8s/talsecret/CLUSTER_SECRET
secrets:
  bootstraptoken: op://k8s/talsecret/SECRETS_BOOTSTRAPTOKEN
  secretboxencryptionsecret: op://k8s/talsecret/SECRETS_SECRETBOXENCRYPTIONSECRET
trustdinfo:
  token: op://k8s/talsecret/TRUSTDINFO_TOKEN
certs:
  etcd:
    crt: op://k8s/talsecret/CERTS_ETCD_CRT
    key: op://k8s/talsecret/CERTS_ETCD_KEY
  k8s:
    crt: op://k8s/talsecret/CERTS_K8S_CRT
    key: op://k8s/talsecret/CERTS_K8S_KEY
  k8saggregator:
    crt: op://k8s/talsecret/CERTS_K8SAGGREGATOR_CRT
    key: op://k8s/talsecret/CERTS_K8SAGGREGATOR_KEY
  k8sserviceaccount:
    key: op://k8s/talsecret/CERTS_K8SSERVICEACCOUNT_KEY
  os:
    crt: op://k8s/talsecret/CERTS_OS_CRT
    key: op://k8s/talsecret/CERTS_OS_KEY
