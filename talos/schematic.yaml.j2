---
customization:
  extraKernelArgs:
    - -init_on_alloc
    - -init_on_free
    - -selinux
    - apparmor=0
    - init_on_alloc=0
    - init_on_free=0
    - mitigations=off
    - intel_iommu=on
    - iommu=pt
    - net.ifnames=0
    - security=none
    - talos.auditd.disabled=1
  systemExtensions:
    officialExtensions:
      - siderolabs/gasket-driver
      - siderolabs/i915
      - siderolabs/intel-ucode
      - siderolabs/thunderbolt
